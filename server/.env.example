# ORBIT Core Environment Configuration Example
# Copy this file to .env and provide your credentials

# Port for local dev or custom hosting (Render automatically assigns PORT)
PORT=3001

# Google Gemini API Key from Google AI Studio (Required for Extraction & Conflict Detection)
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model override (defaults to gemini-2.5-flash with automatic fallbacks)
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration (Optional - Falls back to local tracker if omitted)
# Personal Access Token with 'repo' or 'public_repo' scope
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=owner/repository_name
